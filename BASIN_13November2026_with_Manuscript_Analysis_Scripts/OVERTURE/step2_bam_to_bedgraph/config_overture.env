# ==============================================================================
# OVERTURE Step 2 — config file
#
# Copy this file, fill in your values, and pass it as the second argument to
# run_overture_manifest.sh:
#
#   sbatch run_overture_manifest.sh templates/igg_samples.tsv config_overture.env
#
# One genome per run. The GENOME_ID here must match the genome_id column in
# your igg_samples.tsv manifest.
# ==============================================================================

# Reference genome identifier (must match genome_id column in manifest)
GENOME_ID="dm6"

# CPU threads for bamCoverage
THREADS=8

# Tag describing this run (used in the output directory name)
# For universal panel discovery:    RUN_TAG="universal"
# For experiment-specific discovery: RUN_TAG="experiment_specific"
RUN_TAG="universal"

# Timestamp (auto-generated at runtime — do not set manually)
RUN_TS="$(date +%Y%m%d_%H%M%S)"

# Output directory (auto-constructed from tag and timestamp)
OUTDIR="$PWD/overture_run_${GENOME_ID}_${RUN_TAG}_${RUN_TS}"

# Canonical BAR-discovery coverage contract.
# Geometry is fixed by OVERTURE: binSize=1, no centering, no extension.
# MAPQ remains configurable; 0 matches the distributed dm6 BAR discovery run.
MIN_MAPQ=0

# Set to true to symlink BAMs into the output directory instead of copying
LINK_LOCAL_INPUTS=true

# SEACR: leave MATCH_TOKEN blank to run SEACR on ALL bedGraphs in the output dir
# (recommended when the directory contains only IgG samples from this run)
SEACR_MATCH_TOKEN=""

# Whether to auto-submit SEACR and consensus jobs after bedGraph generation
RUN_SEACR=true
RUN_CONSENSUS=true
